BOT_TOKEN=replace-me-with-your-telegram-bot-token
TIMEZONE=Europe/Minsk
GREETING_TEXT=Привет друг! Как ты)
DATABASE_PATH=/app/data/hellomate.db
# DATABASE_URL overrides DATABASE_PATH. Leave empty to use local SQLite at DATABASE_PATH.
# PostgreSQL example (bot connects to a remote DB, e.g. over a private VPN address):
#   DATABASE_URL=postgresql+psycopg://hellomate:CHANGE_ME@10.0.0.2:5432/hellomate
DATABASE_URL=
LOG_LEVEL=INFO
ADMIN_USER_IDS=
DEFAULT_LANGUAGE=ru
GREETING_HOUR=9
CONVERSATION_STARTERS=data/starters.json
MEMORY_WINDOW_SIZE=20
# Maximum estimated input tokens for compiled reply context. Persona and safety
# policies remain included even if they alone exceed this ceiling.
CONTEXT_TOKEN_BUDGET=4000
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_EMBEDDING_MODEL=bge-m3:latest
LLM_API_KEY=
LLM_MAX_TOKENS=512
# Sampling temperature (0.0-2.0). Lower = more focused/less rambling; raise for
# more variety. 0.7 is a good default for chat. Weak/quantized models ramble at
# high temperatures (leaking meta-text), so keep this modest.
LLM_TEMPERATURE=0.7
AI_REPLIES_ENABLED=false
MINI_APP_URL=
MINI_APP_DEV=true
API_HOST=0.0.0.0
API_PORT=8080
RAG_CHUNK_SIZE=500
RAG_TOP_K=3
WEATHER_CITY=Minsk
# Owner identity — used to personalize AI persona prompts
OWNER_NAME=Owner
BOT_NAME=HelloMate
# Telegram Business: bot replies in owner's private chats (Settings → Telegram Business → Chatbots)
BUSINESS_MODE_ENABLED=true
# Seconds to wait after the last contact message before replying (batches rapid short messages).
# The timer restarts on every new message; a single human pause longer than this splits the
# batch. 8-12 reliably coalesces "finishing a thought"; lower feels snappier. 0 = off.
REPLY_DEBOUNCE_SECONDS=8
# Rolling conversation summary: compresses history older than MEMORY_WINDOW_SIZE so the
# bot keeps context beyond the recent window. Refresh fires after this many messages age out.
SUMMARY_ENABLED=true
SUMMARY_REFRESH_INTERVAL=10
SUMMARY_MAX_CHARS=1500
# Per-contact durable facts: LLM extracts stable facts (name, city, job, birthday, interests…)
# from messages and injects them into the system prompt so the bot "remembers" the person.
# Extraction fires after this many new contact messages.
FACTS_ENABLED=true
FACTS_REFRESH_INTERVAL=5
# Owner writing-style learning (opt-in per contact via the Mini App): the bot learns the
# owner's real writing manner and mimics it. Learns only from the owner's genuine replies,
# never from AI-generated ones. Refresh fires after this many new owner messages.
STYLE_ENABLED=true
STYLE_REFRESH_INTERVAL=5
STYLE_MAX_CHARS=800

# Phase 13: Semantic recall via message embeddings.
# Indexes contact messages as they arrive; retrieves the most relevant past
# messages to inject into the reply context (between summary and live window).
# Uses the same embedding model as RAG (LLM_EMBEDDING_MODEL).
# RECALL_MIN_SCORE: cosine similarity threshold (0-1); 0.5 is a good default.
# RECALL_BACKFILL_BATCH: messages to index per incoming message (backfill rate).
RECALL_ENABLED=true
RECALL_TOP_K=3
RECALL_MIN_CHARS=15
RECALL_MIN_SCORE=0.5
RECALL_BACKFILL_BATCH=50
